# ─── NVIDIA NIM (for LLM / chat answers) ─────────────────────────────────────
# Get your free key from: https://build.nvidia.com
# Click any model → "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA model to use for answering questions
# Options:
#   meta/llama-3.1-70b-instruct     ← best quality (recommended)
#   meta/llama-3.1-8b-instruct      ← faster, uses fewer credits
#   mistralai/mixtral-8x7b-instruct-v0.1
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct

# ─── OLLAMA (for embeddings — free, runs locally) ─────────────────────────────
# Make sure Ollama is installed and nomic-embed-text is pulled:
#   ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
